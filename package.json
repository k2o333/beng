{
  "name": "renmai-bar",
  "productName": "人脉圈 Alpha",
  "version": "0.1.0",
  "description": "桌面底部通栏像素放置游戏（单机 v1）",
  "main": "main.js",
  "author": "proj.beng",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node tests/test-engine.js && node tests/test-agent.js",
    "sim": "node scripts/sim.js",
    "balance": "node scripts/balance-report.js",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.beng.renmaibar",
    "productName": "RenmaiBar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
